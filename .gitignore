
# ==========================================
# MeetTools - Professional .gitignore
# Next.js + Express + TypeScript + BullMQ
# ==========================================

# ==========================================
# Dependencies & Package Managers
# ==========================================
node_modules/
.pnpm-store/
.yarn/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
.npm/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
*.env
*.env.local

# Allow safe example environment files
!.env.example
!.env.*.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Local credentials
credentials.json
service-account*.json
secrets.json

# ==========================================
# TypeScript & Build Outputs
# ==========================================
dist/
build/
out/
*.tsbuildinfo

# ==========================================
# Next.js Build Outputs
# ==========================================
.next/
export/

# Keep next-env.d.ts tracked by Git

# ==========================================
# Logs & Debugging
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pm2.log

# ==========================================
# Redis & Local Database Files
# ==========================================
dump.rdb
appendonly.aof
appendonlydir/
*.sqlite
*.sqlite3
*.db

# ==========================================
# Uploads & Temporary Files
# ==========================================
uploads/
tmp/
temp/
.tmp/
*.tmp

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# ==========================================
# IDE & Editor Files
# ==========================================
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ==========================================
# Testing & Coverage
# ==========================================
coverage/
.nyc_output/
.jest/
test-results/
playwright-report/
blob-report/
playwright/.cache/
*.lcov

# ==========================================
# Performance Testing Outputs
# ==========================================
k6-results/
load-test-results/
performance-results/

# ==========================================
# Cache Directories
# ==========================================
.cache/
.eslintcache
.stylelintcache
.turbo/
.parcel-cache/

# ==========================================
# Local Deployment Artifacts
# ==========================================
.vercel/
.netlify/
.wrangler/
.dev.vars
.dev.vars.*

# ==========================================
# IMPORTANT: Keep these tracked
# ==========================================
# .github/workflows/
# .github/dependabot.yml
# Backend/src/
# frontend/src/
# tests/
# package.json
# package-lock.json
# tsconfig.json
# next.config.ts
# next-env.d.ts
